{
  // NOTE: This is a template configuration file for development.
  // All sensitive values (marked with YOUR_*) should be overridden via:
  // - appsettings.Development.json (git-ignored)
  // - Environment variables in production
  // - Azure Key Vault or similar secret management service
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Replace YOUR_DB_PASSWORD with actual credentials via environment variables
    // Pool settings: MinPoolSize=5 (warm start), MaxPoolSize=100, Idle connections closed after 300s, Command timeout 30s
    "DefaultConnection": "Host=localhost;Port=5432;Database=devhunt_db;Username=postgres;Password=YOUR_DB_PASSWORD;Pooling=true;MinPoolSize=5;MaxPoolSize=100;Connection Idle Lifetime=300;Connection Pruning Interval=10;Timeout=30;Command Timeout=30",
    "ReadOnlyConnection": "Host=localhost;Port=5432;Database=devhunt_db;Username=postgres;Password=YOUR_DB_PASSWORD;Pooling=true;MinPoolSize=2;MaxPoolSize=50;Connection Idle Lifetime=300;Connection Pruning Interval=10;Timeout=30;Command Timeout=30",
    "RedisConnection": "localhost:6379"
  },
  "Jwt": {
    // Replace with actual secret key (minimum 32 characters) via environment variables
    "Key": "YOUR_SUPER_SECRET_KEY_THAT_IS_LONG_AND_COMPLEX",
    "Issuer": "DevHunt.AuthService",
    "Audience": "DevHunt.CoreApi"
  },
  "Encryption": {
    // Replace with actual 32-byte encryption key via environment variables
    "Key": "YOUR_ENCRYPTION_KEY_32_BYTES_LONG",
    "IV": "YOUR_IV_16_BYTES"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://search-service:9200",
          "indexFormat": "devhunt-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "numberOfShards": 1,
          "numberOfReplicas": 0
        }
      }
      // NOTE: "Elasticsearch" sink name works with OpenSearch (API-compatible)
    ]
  },
  "KeyVault": {
    "Uri": ""
  },
  "Tracing": {
    "AgentHost": "${TRACING__AGENTHOST:-tracing-service}",
    "AgentPort": "${TRACING__AGENTPORT:-4317}",
    "ServiceName": "${TRACING__SERVICENAME:-DevHunt.CoreApi}"
  },
  "SearchService": {
    "Uri": "http://search-service:9200"
  },
  // NOTE: Sentry removed - using Serilog + Prometheus for error tracking
  // "Sentry": {
  //   "Dsn": ""
  // },
  "RabbitMQ": {
    "ConnectionString": "${RABBITMQ__CONNECTIONSTRING:-}",
    "ExchangeName": "${RABBITMQ__EXCHANGENAME:-devhunt.events}"
  },
  "ObjectStorage": {
    "Endpoint": "${OBJECTSTORAGE__ENDPOINT:-http://object-storage:8333}",
    "AccessKey": "${OBJECTSTORAGE__ACCESSKEY:-}",
    "SecretKey": "${OBJECTSTORAGE__SECRETKEY:-}",
    "Region": "${OBJECTSTORAGE__REGION:-us-east-1}"
  },
  "Prometheus": {
    "Endpoint": "/metrics"
  },
  "MLService": {
    "BaseUrl": "${MLSERVICE__BASEURL:-http://ml-service:8000}",
    "ServiceToken": "${MLSERVICE__SERVICETOKEN:-}"
  },
  "IntegrationGateway": {
    "BaseUrl": "${INTEGRATIONGATEWAY__BASEURL:-http://integration-gateway:5002}"
  },
  "NotificationService": {
    "BaseUrl": "${NOTIFICATIONSERVICE__BASEURL:-http://notification-service:5003}"
  },
  "Email": {
    "FromEmail": "noreply@devhunt.example.com",
    "FromName": "DevHunt",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "UseSsl": true,
    "SendGridApiKey": ""
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/projects",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/users",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "PUT:/api/profile",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/profile",
        "Period": "1m",
        "Limit": 10
      }
    ]
  }
}
