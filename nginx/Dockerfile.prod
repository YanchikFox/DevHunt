FROM nginx:alpine

# Production: TLS redirect + HTTPS server with security headers and rate limits
COPY rate-limit-zones.conf /etc/nginx/conf.d/00-rate-limit-zones.conf
COPY edge-security.inc /etc/nginx/conf.d/edge-security.inc
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /etc/nginx/ssl /var/www/certbot && \
    apk add --no-cache openssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/key.pem \
    -out /etc/nginx/ssl/cert.pem \
    -subj "/C=US/ST=State/L=City/O=DevHunt/CN=localhost" && \
    chmod 644 /etc/nginx/ssl/cert.pem && \
    chmod 600 /etc/nginx/ssl/key.pem

RUN chown -R nginx:nginx /etc/nginx/ssl /var/www/certbot /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8080 8443

CMD ["nginx", "-g", "daemon off;"]
