.git/
.gitignore

# Documentation generated files (will be regenerated)
docs/api/swagger/
docs/frontend/api/
# Note: static/docfx/ is NOT excluded - placeholder must be available even if DocFX is skipped

# Exclude other services' build artifacts
**/bin/
**/obj/
**/node_modules/
**/.next/
**/dist/
**/build/# Exclude test projects
**/*.Tests/
**/tests/
**/test/

# Exclude frontend build artifacts
frontend/.next/
frontend/out/
frontend/dist/# Exclude database files
*.db
*.sqlite
*.sqlite3

# Exclude environment files
.env
.env.local
.env.*.local
