.husky/_/

# ========================================
# Documentation (Docusaurus)
# ========================================
documentation/build/
documentation/.docusaurus/
documentation/.cache-loader
documentation/public/
documentation/tsconfig.json
documentation/tsconfig.typedoc.json
documentation/swagger-ui.html
# Stale TypeDoc output committed under wrong path (removed in Batch 1)
documentation/frontend/
# TypeDoc generation output (regenerated by gen:typedoc)
documentation/docs/frontend/api/
# Docker volume artifact — appears when documentation/ is mounted as a volume
documentation/documentation/
# DocFX intermediate output — postprocess-docfx.js reads this, strips prose, writes to static/docfx/
documentation/.docfx-output/
# DocFX generated metadata YAML (produced by dotnet build + docfx metadata, not source files)
documentation/docfx/api/
# OpenAPI plugin generated MDX pages (regenerated by gen:openapi)
documentation/docs/api/swagger/
documentation/docs/api/auth-swagger/
documentation/docs/api/ml-swagger/
# OpenAPI specs copied/generated for the documentation portal
documentation/static/api/*.json
# Swagger UI static vendor assets are copied from node_modules/swagger-ui-dist
documentation/static/swagger-ui/*.css
documentation/static/swagger-ui/*.js
documentation/static/swagger-ui/*.map
# DocFX final static output (regenerated by gen:docfx)
documentation/static/docfx/
documentation/static/api-reference/
# Mermaid diagram pages (regenerated by gen:diagrams)
documentation/docs/architecture/generated/

# mkdocs
/site

# ========================================
# Docker
# ========================================
docker-compose.override.yml

